  refillsReserved                         Int?                @default(0)
  quantityDispensed                       Int?                @default(0)
  substitutionAllowed                     Boolean             @default(false)
  prescription                            Prescription        @relation("PrescriptionItem_prescription", fields: [prescriptionId], references: [id])
  prescriptionId                          String              @map("prescription")
  drugReference                           DrugReference       @relation("PrescriptionItem_drugReference", fields: [drugReferenceId], references: [id])
  drugReferenceId                         String              @map("drugReference")
  product                                 Product             @relation("PrescriptionItem_product", fields: [productId], references: [id])
  productId                               String              @map("product")
  refillRequests                          RefillRequest[]     @relation("RefillRequest_prescriptionItem")
  dispensingLabels                        DispensingLabel[]   @relation("DispensingLabel_prescriptionItem")
  createdAt                               DateTime            @default(now())
  updatedAt                               DateTime            @default(now()) @updatedAt
  from_InventoryMovement_prescriptionItem InventoryMovement[] @relation("InventoryMovement_prescriptionItem")
  from_PrescriptionFill_prescriptionItem  PrescriptionFill[]  @relation("PrescriptionFill_prescriptionItem")

  @@index([prescriptionId])
  @@index([drugReferenceId])
  @@index([productId])
}

model PrescriptionRequest {
  id                String           @id @default(cuid())
  idempotencyKey    String           @unique @default("")
  kind              String
  status            String?          @default("requested")
  organization      Organization     @relation("PrescriptionRequest_organization", fields: [organizationId], references: [id])
  organizationId    String           @map("organization")
  location          PharmacyLocation @relation("PrescriptionRequest_location", fields: [locationId], references: [id])
  locationId        String           @map("location")
  user              User             @relation("PrescriptionRequest_user", fields: [userId], references: [id])
  userId            String           @map("user")
  patient           PatientProfile?  @relation("PrescriptionRequest_patient", fields: [patientId], references: [id])
  patientId         String?          @map("patient")
  firstName         String           @default("")
  lastName          String           @default("")
  dateOfBirth       DateTime?
  phone             String           @default("")
  email             String           @default("")
  allergies         String           @default("")
  insurance         String           @default("")
  counterpartyName  String           @default("")
  counterpartyPhone String           @default("")
  prescriberName    String           @default("")
  prescriberPhone   String           @default("")
  medications       String           @default("")
  note              String           @default("")
  resolutionNote    String           @default("")
  resolvedAt        DateTime?
  resolvedBy        User?            @relation("PrescriptionRequest_resolvedBy", fields: [resolvedById], references: [id])
  resolvedById      String?          @map("resolvedBy")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  @@index([organizationId])
  @@index([locationId])
  @@index([userId])
  @@index([patientId])
  @@index([resolvedById])
}

model PrescriptionReview {
  id             String         @id @default(cuid())
  decision       String
  reason         String         @default("")
  humanAttested  Boolean        @default(false)
  reviewedAt     DateTime       @default(now())
  prescription   Prescription   @relation("PrescriptionReview_prescription", fields: [prescriptionId], references: [id])
  prescriptionId String         @map("prescription")
  patient        PatientProfile @relation("PrescriptionReview_patient", fields: [patientId], references: [id])
  patientId      String         @map("patient")
  pharmacist     User           @relation("PrescriptionReview_pharmacist", fields: [pharmacistId], references: [id])
  pharmacistId   String         @map("pharmacist")
  approval       HumanApproval  @relation("PrescriptionReview_approval", fields: [approvalId], references: [id])
  approvalId     String         @map("approval")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  @@index([prescriptionId])
  @@index([patientId])
  @@index([pharmacistId])
  @@index([approvalId])
}

model PrescriptionTransfer {
  id                String         @id @default(cuid())
  idempotencyKey    String         @unique @default("")
  direction         String
  status            String?        @default("requested")
  counterpartyName  String         @default("")
  counterpartyPhone String         @default("")
  requestedAt       DateTime?      @default(now())
  completedAt       DateTime?
  patient           PatientProfile @relation("PrescriptionTransfer_patient", fields: [patientId], references: [id])
  patientId         String         @map("patient")
