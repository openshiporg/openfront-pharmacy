  approval          HumanApproval?    @relation("RecallExposure_approval", fields: [approvalId], references: [id])
  approvalId        String?           @map("approval")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  @@index([organizationId])
  @@index([locationId])
  @@index([recallId])
  @@index([movementId])
  @@index([patientId])
  @@index([prescriptionId])
  @@index([orderId])
  @@index([lastActorId])
  @@index([approvalId])
