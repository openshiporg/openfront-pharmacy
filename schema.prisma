  from_DispensingLabel_pharmacist                  DispensingLabel[]        @relation("DispensingLabel_pharmacist")
  from_DrugReference_reviewedBy                    DrugReference[]          @relation("DrugReference_reviewedBy")
  from_DrugReferenceReview_reviewedBy              DrugReferenceReview[]    @relation("DrugReferenceReview_reviewedBy")
  from_Fulfillment_assignedTo                      Fulfillment[]            @relation("Fulfillment_assignedTo")
  from_InventoryMovement_actor                     InventoryMovement[]      @relation("InventoryMovement_actor")
  from_Organization_cashPolicyReviewedBy           Organization[]           @relation("Organization_cashPolicyReviewedBy")
  from_OrganizationMembership_credentialVerifiedBy OrganizationMembership[] @relation("OrganizationMembership_credentialVerifiedBy")
  from_PatientAllergy_recordedBy                   PatientAllergy[]         @relation("PatientAllergy_recordedBy")
  from_PatientMedication_recordedBy                PatientMedication[]      @relation("PatientMedication_recordedBy")
  from_PatientProfile_identityVerifiedBy           PatientProfile[]         @relation("PatientProfile_identityVerifiedBy")
  from_Payment_recordedBy                          Payment[]                @relation("Payment_recordedBy")
  from_Prescriber_verifiedBy                       Prescriber[]             @relation("Prescriber_verifiedBy")
  from_PrescriptionFill_reservedBy                 PrescriptionFill[]       @relation("PrescriptionFill_reservedBy")
  from_PrescriptionFillEvent_actor                 PrescriptionFillEvent[]  @relation("PrescriptionFillEvent_actor")
  from_PrescriptionRequest_user                    PrescriptionRequest[]    @relation("PrescriptionRequest_user")
  from_PrescriptionRequest_resolvedBy              PrescriptionRequest[]    @relation("PrescriptionRequest_resolvedBy")
  from_RecallExposure_lastActor                    RecallExposure[]         @relation("RecallExposure_lastActor")
