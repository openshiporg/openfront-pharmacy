model Product {
  id                             String              @id @default(cuid())
  title                          String              @default("")
  handle                         String              @unique @default("")
  sku                            String              @unique @default("")
  description                    String              @default("")
  status                         String?             @default("draft")
  category                       String?             @default("otc_medication")
  prescriptionRequirement        String?             @default("none")
  priceAmount                    Int                 @default(0)
  currencyCode                   String              @default("USD")
  taxable                        Boolean             @default(true)
  onlineAvailable                Boolean             @default(false)
  posAvailable                   Boolean             @default(true)
  coldChainRequired              Boolean             @default(false)
  imageUrl                       String              @default("")
  organization                   Organization        @relation("Product_organization", fields: [organizationId], references: [id])
  organizationId                 String              @map("organization")
  location                       PharmacyLocation    @relation("Product_location", fields: [locationId], references: [id])
  locationId                     String              @map("location")
  drugReference                  DrugReference?      @relation("Product_drugReference", fields: [drugReferenceId], references: [id])
  drugReferenceId                String?             @map("drugReference")
  inventoryLots                  InventoryLot[]      @relation("InventoryLot_product")
  cartItems                      CartItem[]          @relation("CartItem_product")
  orderLineItems                 OrderLineItem[]     @relation("OrderLineItem_product")
  prescriptionItems              PrescriptionItem[]  @relation("PrescriptionItem_product")
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @default(now()) @updatedAt
  from_InventoryMovement_product InventoryMovement[] @relation("InventoryMovement_product")

  @@index([organizationId])
  @@index([locationId])
  @@index([drugReferenceId])
}

model Recall {
  id                        String            @id @default(cuid())
  recallNumber              String            @unique @default("")
  classification            String?           @default("unverified")
  status                    String?           @default("draft")
  reason                    String            @default("")
  source                    String            @default("")
  sourceValidationReference String            @default("")
  initiatedAt               DateTime?         @default(now())
  closedAt                  DateTime?
  organization              Organization      @relation("Recall_organization", fields: [organizationId], references: [id])
  organizationId            String            @map("organization")
  location                  PharmacyLocation? @relation("Recall_location", fields: [locationId], references: [id])
  locationId                String?           @map("location")
  lots                      InventoryLot[]    @relation("InventoryLot_recalls")
  exposures                 RecallExposure[]  @relation("RecallExposure_recall")
  approval                  HumanApproval?    @relation("Recall_approval", fields: [approvalId], references: [id])
  approvalId                String?           @map("approval")
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @default(now()) @updatedAt

  @@index([organizationId])
  @@index([locationId])
  @@index([approvalId])
}

model RecallExposure {
